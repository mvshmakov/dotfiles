# Hosts that must not be public (private infrastructure, work) live in
# ~/.ssh/config.d/, which is not in this repo. Included first: ssh uses the
# first value it finds, so those blocks win over Host * below.
Include config.d/*

Host *
   # Using TouchId for SSH
   AddKeysToAgent yes
   IgnoreUnknown UseKeychain
   UseKeychain yes	 
   Compression yes
   IdentityFile ~/.ssh/id_rsa
   ForwardAgent yes

Host localhost
   HostName localhost
   Port 2222

# Setting up the test accounts on each git provider respectively
Host bitbucket-test
  HostName bitbucket.org
  User git
  IdentityFile ~/.ssh/id_rsa-test
  IdentitiesOnly yes

Host github-test
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_rsa-test
  IdentitiesOnly yes

Host gitlab-test
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/id_rsa-test
  IdentitiesOnly yes
